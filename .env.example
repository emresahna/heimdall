NODE_NAME=localhost
SERVER_ADDR=localhost:50051
PORT=50051
HTTP_PORT=8080
METRICS_PORT=9090
K8S_ENRICH=false
DIAGNOSTICS_INTERVAL=15s
SHUTDOWN_TIMEOUT=5s
# Payload sampling (0 = off; requires a configured redactor before bytes are stored)
HTTP_SAMPLE_BYTES=0

# ClickHouse
CLICKHOUSE_ADDR=127.0.0.1:9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default
CLICKHOUSE_MAX_EXECUTION_TIME=60s
CLICKHOUSE_ASYNC_INSERT=true

# Correlator
CORRELATOR_TTL=30s

# Batcher
BATCHER_BATCH_SIZE=200
BATCHER_FLUSH_INTERVAL=2s
BATCHER_MAX_QUEUE=1000
BATCHER_RETRY_BACKOFF=200ms

# Circuit Breaker
CB_THRESHOLD=5
CB_RESET_TIMEOUT=30s

# Security (TLS)
USE_TLS=false
TLS_CERT_FILE=certs/server.crt
TLS_KEY_FILE=certs/server.key
TLS_CA_FILE=certs/ca.crt
